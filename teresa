<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Teresa Rafaela — Marketing & Brand Strategist</title>
<meta name="description" content="Marketing & brand strategist in Hong Kong. Brand, social and analytics case studies: KamePet, Cuddle Croo, IM8 and more.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--paper:#FBFAF9;--ink:#1D1530;--muted:#5E5873;--red:#E43D30;--lilac:#E7E1FA;--line:#DDD8EA;--card:#fff;
--d:'Bricolage Grotesque',Georgia,serif;--b:'DM Sans',system-ui,sans-serif}
@media(prefers-color-scheme:dark){:root{--paper:#15101F;--ink:#F4F1FB;--muted:#B0A9C4;--red:#FF6A5C;--lilac:#2A2142;--line:#3A3057;--card:#1D1630}}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{background:var(--paper);color:var(--ink);font:400 1.05rem/1.65 var(--b);-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--red);outline-offset:3px;border-radius:4px}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:var(--d);line-height:1.05;letter-spacing:-.02em}
h2{font-size:clamp(2rem,4.5vw,3.4rem);font-weight:800;max-width:18ch}
p{max-width:62ch}
section{padding:96px 0}

/* nav */
nav{position:sticky;top:0;z-index:10;background:color-mix(in srgb,var(--paper) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font:800 1.2rem var(--d);text-decoration:none}
.logo b{color:var(--red)}
nav ul{display:flex;gap:28px;list-style:none;padding:0}
nav ul a{text-decoration:none;font-weight:500;font-size:.95rem;color:var(--muted)}
nav ul a:hover{color:var(--ink)}
@media(max-width:640px){nav ul{gap:14px}nav ul li:nth-child(n+4){display:none}}

/* hero */
.hero{padding:72px 0 88px}
.hero .wrap{display:grid;grid-template-columns:1.25fr .75fr;gap:56px;align-items:center}
.hero h1{font-size:clamp(2.8rem,7.4vw,6rem);font-weight:800}
.hero h1 em{font-style:normal;background:linear-gradient(transparent 62%,var(--lilac) 62%)}
.hero .tag{color:var(--muted);font-weight:500;margin-bottom:20px}
.hero .lede{margin:28px 0 36px;font-size:1.2rem;color:var(--muted)}
.btns{display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-block;padding:14px 26px;border-radius:999px;font-weight:700;text-decoration:none;border:2px solid var(--ink);transition:transform .15s}
.btn.pri{background:var(--red);border-color:var(--red);color:#fff}
.btn:hover{transform:translateY(-2px)}
.photo{aspect-ratio:4/5;border-radius:999px 999px 24px 24px;background:var(--lilac);overflow:hidden;border:2px solid var(--ink)}
.photo img{width:100%;height:100%;object-fit:cover}
@media(max-width:860px){.hero .wrap{grid-template-columns:1fr}.photo{max-width:320px;order:-1}}

/* proof strip */
.strip{background:var(--ink);color:var(--paper);padding:36px 0}
.strip .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:24px}
.strip strong{display:block;font:800 clamp(1.8rem,4vw,2.8rem)/1 var(--d);color:#fff}
.strip span{font-size:.9rem;color:#C9C2DD}
@media(prefers-color-scheme:dark){.strip{background:#241B3A}}
@media(max-width:700px){.strip .wrap{grid-template-columns:1fr 1fr}}

/* about */
.about .wrap{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start}
.about p+p{margin-top:16px}
.facts{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:28px 30px;list-style:none}
.facts li{padding:12px 0;border-bottom:1px solid var(--line)}
.facts li:last-child{border:0}
.process{display:flex;gap:10px;flex-wrap:wrap;margin:28px 0 0;padding:0;list-style:none;counter-reset:s}
.process li{counter-increment:s;font-weight:700;padding:8px 16px;border-radius:999px;background:var(--lilac)}
.process li::before{content:counter(s) ". ";color:var(--red)}
.clients{margin-top:28px;color:var(--muted);font-size:.95rem}
@media(max-width:860px){.about .wrap{grid-template-columns:1fr;gap:36px}}

/* work */
.work h2{margin-bottom:56px}
.case{display:grid;grid-template-columns:1fr 1fr;gap:48px;padding:56px 0;border-top:2px solid var(--ink);align-items:center}
.case:nth-of-type(even) .media{order:2}
.media{aspect-ratio:4/3;border-radius:20px;background:var(--lilac);overflow:hidden;display:grid;place-items:center;text-align:center;color:var(--muted);font-weight:500;padding:20px}
.media img{width:100%;height:100%;object-fit:cover}
.meta{font-size:.9rem;color:var(--muted);font-weight:500;margin-bottom:10px}
.badge{display:inline-block;background:var(--red);color:#fff;font-size:.8rem;font-weight:700;padding:3px 12px;border-radius:999px;margin-right:8px}
.case h3{font-size:clamp(1.9rem,3.5vw,2.6rem);font-weight:800;margin-bottom:14px}
.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:18px 24px;margin-top:28px}
.nums b{display:block;font:800 2.1rem/1 var(--d);color:var(--red)}
.nums span{font-size:.88rem;color:var(--muted);line-height:1.3;display:block;margin-top:4px}
.hero-num b{font-size:clamp(3rem,7vw,4.6rem)}
@media(max-width:860px){.case{grid-template-columns:1fr;gap:28px}.case:nth-of-type(even) .media{order:0}}

/* toolkit */
.tools{background:var(--lilac)}
.tools h2{margin-bottom:44px}
.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
.tool{background:var(--card);border-radius:20px;padding:28px;border:1px solid var(--line)}
.tool h3{font-size:1.4rem;margin-bottom:12px}
.tool ul{padding-left:18px;color:var(--muted);margin-bottom:16px}
.tool small{display:block;font-weight:500;border-top:1px solid var(--line);padding-top:12px}

/* beyond */
.beyond h2{margin-bottom:44px}
.grid3{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px}
.b-item .ph{aspect-ratio:3/2;border-radius:16px;background:var(--lilac);overflow:hidden;margin-bottom:14px}
.b-item .ph img{width:100%;height:100%;object-fit:cover}
.b-item h3{font-size:1.2rem;margin-bottom:4px}
.b-item p{color:var(--muted);font-size:.98rem}

/* contact */
.contact{background:var(--ink);color:#fff;text-align:center}
.contact h2{margin:0 auto 20px;color:#fff;max-width:16ch}
.contact p{margin:0 auto 32px;color:#C9C2DD}
.contact .btn{border-color:#fff;color:#fff}
.contact .btn.pri{border-color:var(--red)}
@media(prefers-color-scheme:dark){.contact{background:#241B3A}}
footer{padding:28px 0;text-align:center;font-size:.9rem;color:var(--muted)}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
